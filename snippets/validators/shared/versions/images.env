# Base image for the Node runtime validator.
NODE_IMAGE=node:22
# Node base used by npm-enabled slim validators and shell-install.
NODE_BOOKWORM_SLIM_IMAGE=node:22-bookworm-slim
# Node base used by the React Native validator.
NODE_BOOKWORM_IMAGE=node:22-bookworm
# Playwright browsers and Node base used by browser and Flutter validators;
# keep this matched with PLAYWRIGHT_VERSION in npm.env.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble
# Base used by Android validation.
ANDROID_IMAGE=eclipse-temurin:17-jdk-noble
# Base used by C++ and Lua validators that need Debian.
DEBIAN_BOOKWORM_SLIM_IMAGE=debian:bookworm-slim
# Base used by C++ and Lua validators that need Ubuntu.
UBUNTU_IMAGE=ubuntu:24.04
# Base used by .NET validators.
DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
# Base used by Erlang validation.
ERLANG_IMAGE=erlang:26
# Base used by Go validation.
GO_IMAGE=golang:1.25
# Base used by Haskell validators.
HASKELL_IMAGE=haskell:9.6.7-bullseye
# Base used by JVM validation.
JVM_IMAGE=maven:3.9-eclipse-temurin-17
# Base used by PHP validation.
PHP_IMAGE=php:8.3-cli
# Base used by Python validation.
PYTHON_IMAGE=python:3.11-slim
# Base used by Ruby validation.
RUBY_IMAGE=ruby:3.3
# Base used by Rust validation.
RUST_IMAGE=rust:1.94
