# Format: plain KEY=value entries, one per line; no quotes, shell interpolation, or spaces around =.
# Base image for the Node runtime validator.
NODE_IMAGE=node:22
# Node base used by the apex, edge-ts, edge-tsc, roku-client, and shell-install validators.
NODE_BOOKWORM_SLIM_IMAGE=node:22-bookworm-slim
# Node base used by the react-native-client validator.
NODE_BOOKWORM_IMAGE=node:22-bookworm
# Playwright browsers and Node base used by the js-client, react-client, vue-client,
# flutter-client, flutter-client-v2, and flutter-client-v3 validators; keep this
# matched with PLAYWRIGHT_VERSION in npm.env for the browser validators.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble
# Base used by the android-client validator.
ANDROID_IMAGE=eclipse-temurin:17-jdk-noble
# Base used by the cpp-client-v2-c, cpp-client-v2-cpp, cpp-server-v2-c,
# cpp-server-v2-cpp, and xml validators.
DEBIAN_BOOKWORM_SLIM_IMAGE=debian:bookworm-slim
# Base used by the cpp-client, cpp-server, and lua-server validators.
UBUNTU_IMAGE=ubuntu:24.04
# Base used by the dotnet-client and dotnet-server validators.
DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
# Base used by the erlang-server validator.
ERLANG_IMAGE=erlang:26
# Base used by the go validator.
GO_IMAGE=golang:1.25
# Base used by the haskell-server and haskell-server-v3 validators.
HASKELL_IMAGE=haskell:9.6.7-bullseye
# Base used by the jvm validator.
JVM_IMAGE=maven:3.9-eclipse-temurin-17
# Base used by the php validator.
PHP_IMAGE=php:8.3-cli
# Base used by the python validator.
PYTHON_IMAGE=python:3.11-slim
# Base used by the ruby validator.
RUBY_IMAGE=ruby:3.3
# Base used by the rust validator.
RUST_IMAGE=rust:1.94
