# Format: plain KEY=value entries, one per line; no quotes, shell interpolation, or spaces around =.
# Android command-line tools archive consumed by the android-client validator.
CMDLINE_TOOLS_VERSION=11076708
# Git ref used by the android-client validator's pre-baked hello app.
HELLO_ANDROID_REF=main
# Robolectric consumed by the android-client validator.
ROBOLECTRIC_VERSION=4.12.2
# Flutter SDK archive consumed by the flutter-client, flutter-client-v2, and flutter-client-v3 validators.
FLUTTER_VERSION=3.27.4
# Flutter provider package consumed by the flutter-client, flutter-client-v2, and flutter-client-v3 validators.
PROVIDER_VERSION=6.1.2
# GHC and cabal installed via ghcup by the haskell-server validator.
GHC_VERSION=9.6.7
CABAL_VERSION=3.10.3.0
# Go archive consumed by the shell-install validator.
GO_VERSION=1.25.12
# Gradle distribution consumed by the shell-install validator.
GRADLE_VERSION=8.10.2
