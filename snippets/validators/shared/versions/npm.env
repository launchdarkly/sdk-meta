# Format: plain KEY=value entries, one per line; no quotes, shell interpolation, or spaces around =.
# npm used by the node, apex, edge-ts, edge-tsc, roku-client,
# react-native-client, shell-install, js-client, react-client, and vue-client validators.
NPM_VERSION=12
# pnpm provisioned by the shell-install validator.
PNPM_VERSION=11
# Yarn classic provisioned by the shell-install validator.
YARN_VERSION=1
# Prettier used by the Apex validator.
PRETTIER_VERSION=3.4.2
# Apex parser plugin used by the Apex validator.
PRETTIER_PLUGIN_APEX_VERSION=2.2.6
# TypeScript used by the Edge TypeScript validator.
EDGE_TYPESCRIPT_VERSION=5.7.2
# TypeScript used by the Edge TypeScript compiler validator.
EDGE_TSC_TYPESCRIPT_VERSION=5.7.2
# BrighterScript parser used by the Roku validator.
BRIGHTERSCRIPT_VERSION=0.72.4
# Playwright npm client used by js-client, react-client, and vue-client;
# keep this matched with PLAYWRIGHT_IMAGE used by those validators.
PLAYWRIGHT_VERSION=1.60.0
# LaunchDarkly JavaScript client SDK used by the js-client validator.
LD_JS_CLIENT_SDK_VERSION=4.9.4
# Legacy LaunchDarkly JavaScript client SDK used by the js-client validator.
LD_JS_CLIENT_LEGACY_SDK_VERSION=3.9.5
# LaunchDarkly observability package used by the js-client validator.
LD_JS_OBSERVABILITY_VERSION=1.1.18
# LaunchDarkly session replay package used by the js-client validator.
LD_JS_SESSION_REPLAY_VERSION=1.1.18
# tsdown used by the js-client validator.
TSDOWN_VERSION=0.17.0-beta.4
# TypeScript used by the js-client validator.
JS_TYPESCRIPT_VERSION=5.9.3
# LaunchDarkly React SDK used by the react-client validator.
LD_REACT_SDK_VERSION=4.1.12
# Legacy LaunchDarkly React SDK used by the react-client validator.
LD_REACT_LEGACY_SDK_VERSION=3.9.4
# LaunchDarkly observability package used by the react-client validator.
LD_REACT_OBSERVABILITY_VERSION=1.1.18
# LaunchDarkly session replay package used by the react-client validator.
LD_REACT_SESSION_REPLAY_VERSION=1.1.18
# React used by the react-client and react-native-client validators.
REACT_VERSION=19.2.5
# React type declarations used by the react-client validator.
REACT_TYPES_VERSION=19.2.5
# React DOM type declarations used by the react-client validator.
REACT_DOM_TYPES_VERSION=19.2.3
# TypeScript used by the react-client validator.
REACT_TYPESCRIPT_VERSION=5.6.3
# Vite used by the react-client and vue-client validators.
VITE_VERSION=8.0.10
# Vite React plugin used by the react-client validator.
VITE_PLUGIN_REACT_VERSION=6.0.1
# LaunchDarkly Vue SDK used by the vue-client validator.
LD_VUE_SDK_VERSION=2.5.2
# LaunchDarkly observability package used by the vue-client validator.
LD_VUE_OBSERVABILITY_VERSION=1.1.18
# LaunchDarkly session replay package used by the vue-client validator.
LD_VUE_SESSION_REPLAY_VERSION=1.1.18
# Vue used by the vue-client validator.
VUE_VERSION=3.5.33
# Vite Vue plugin used by the vue-client validator.
VITE_PLUGIN_VUE_VERSION=6.0.6
# LaunchDarkly React Native SDK used by the react-native-client validator.
LD_RN_SDK_VERSION=10.19.4
# LaunchDarkly React Native observability package used by the react-native-client validator.
LD_OBSERVABILITY_RN_VERSION=0.18.0
# React Native used by the react-native-client validator.
REACT_NATIVE_VERSION=0.85.2
# React Native Testing Library used by the react-native-client validator.
TESTING_LIBRARY_VERSION=13.3.3
# React Native async-storage package used by the React Native validator.
RN_ASYNC_STORAGE_VERSION=^1.23.1
# Babel core used by the react-native-client validator.
RN_BABEL_CORE_VERSION=^7.25.2
# Babel env preset used by the react-native-client validator.
RN_BABEL_PRESET_ENV_VERSION=^7.25.3
# React test renderer type declarations used by the react-native-client validator.
RN_TYPES_REACT_TEST_RENDERER_VERSION=19.1.0
# Jest used by the react-native-client validator.
RN_JEST_VERSION=^29.7.0
# ts-jest used by the react-native-client validator.
RN_TS_JEST_VERSION=^29.2.5
# TypeScript range used by the react-native-client validator.
RN_TYPESCRIPT_VERSION=^5.6.0
