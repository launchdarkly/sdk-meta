# Floating LaunchDarkly SDK families, one per line as KEY=<registry>:<package>@<family>.
# Family is a numeric version prefix: "4" floats on the newest stable 4.x.y and
# "0.2" on the newest 0.2.x. Before each validator image build the snippets CLI
# resolves the family to an exact release, passes it as the Dockerfile ARG, and
# folds it into the image tag, so a new release rebuilds the image.
# Registries: npm, pub, maven (<group>:<artifact>), hackage, hex,
# luarocks (<user>/<rock>), github-tag (<owner>/<repo>:<tag-prefix>; the full tag is passed).
# This file is not copied into images; Dockerfiles consume the resolved ARGs.
# Keep legacy families on their own major so their snippets keep validating.

# LaunchDarkly edge SDKs type-checked against by the edge-tsc validator.
LD_AKAMAI_EDGEKV_SDK_VERSION=npm:@launchdarkly/akamai-server-edgekv-sdk@1
LD_CLOUDFLARE_SDK_VERSION=npm:@launchdarkly/cloudflare-server-sdk@2
LD_FASTLY_SDK_VERSION=npm:@launchdarkly/fastly-server-sdk@0.2
LD_VERCEL_SDK_VERSION=npm:@launchdarkly/vercel-server-sdk@1
# Shared server SDK common package used by the edge-tsc validator.
LD_JS_SERVER_SDK_COMMON_VERSION=npm:@launchdarkly/js-server-sdk-common@2
# LaunchDarkly JavaScript client SDK used by the js-client validator.
LD_JS_CLIENT_SDK_VERSION=npm:@launchdarkly/js-client-sdk@4
# Legacy LaunchDarkly JavaScript client SDK used by the js-client validator.
LD_JS_CLIENT_LEGACY_SDK_VERSION=npm:launchdarkly-js-client-sdk@3
# LaunchDarkly observability package used by the js-client validator.
LD_JS_OBSERVABILITY_VERSION=npm:@launchdarkly/observability@1
# LaunchDarkly session replay package used by the js-client validator.
LD_JS_SESSION_REPLAY_VERSION=npm:@launchdarkly/session-replay@1
# LaunchDarkly React SDK used by the react-client validator.
LD_REACT_SDK_VERSION=npm:@launchdarkly/react-sdk@4
# Legacy LaunchDarkly React SDK used by the react-client validator.
LD_REACT_LEGACY_SDK_VERSION=npm:launchdarkly-react-client-sdk@3
# LaunchDarkly observability package used by the react-client validator.
LD_REACT_OBSERVABILITY_VERSION=npm:@launchdarkly/observability@1
# LaunchDarkly session replay package used by the react-client validator.
LD_REACT_SESSION_REPLAY_VERSION=npm:@launchdarkly/session-replay@1
# LaunchDarkly Vue SDK used by the vue-client validator.
LD_VUE_SDK_VERSION=npm:launchdarkly-vue-client-sdk@2
# LaunchDarkly observability package used by the vue-client validator.
LD_VUE_OBSERVABILITY_VERSION=npm:@launchdarkly/observability@1
# LaunchDarkly session replay package used by the vue-client validator.
LD_VUE_SESSION_REPLAY_VERSION=npm:@launchdarkly/session-replay@1
# LaunchDarkly React Native SDK used by the react-native-client validator.
LD_RN_SDK_VERSION=npm:@launchdarkly/react-native-client-sdk@10
# LaunchDarkly React Native observability package used by the react-native-client validator.
LD_OBSERVABILITY_RN_VERSION=npm:@launchdarkly/observability-react-native@0.18
# LaunchDarkly Android SDK consumed by the android-client validator.
LD_ANDROID_SDK_VERSION=maven:com.launchdarkly:launchdarkly-android-client-sdk@5
# LaunchDarkly Android observability package consumed by the android-client validator.
LD_ANDROID_OBSERVABILITY_VERSION=maven:com.launchdarkly:launchdarkly-observability-android@0.69
# LaunchDarkly Java server SDK and companion packages consumed by the jvm validator.
LD_JAVA_SERVER_SDK_VERSION=maven:com.launchdarkly:launchdarkly-java-server-sdk@7
LD_JAVA_SERVER_SDK_OTEL_VERSION=maven:com.launchdarkly:launchdarkly-java-server-sdk-otel@0.2
LD_JAVA_REDIS_STORE_VERSION=maven:com.launchdarkly:launchdarkly-java-server-sdk-redis-store@3
LD_JAVA_DYNAMODB_STORE_VERSION=maven:com.launchdarkly:launchdarkly-java-server-sdk-dynamodb-store@5
LD_JAVA_CONSUL_STORE_VERSION=maven:com.launchdarkly:launchdarkly-java-server-sdk-consul-store@5
LD_JAVA_OPENFEATURE_PROVIDER_VERSION=maven:com.launchdarkly:launchdarkly-openfeature-serverprovider@1
# LaunchDarkly C++ client tag consumed by the C++ client validator.
CPP_CLIENT_SDKS_REF=github-tag:launchdarkly/cpp-sdks:launchdarkly-cpp-client-v@3
# LaunchDarkly C++ server tag consumed by the C++ server validator.
CPP_SERVER_SDKS_REF=github-tag:launchdarkly/cpp-sdks:launchdarkly-cpp-server-v@3
# LaunchDarkly C++ server tag consumed by the Lua server validator.
CPP_LUA_SDKS_REF=github-tag:launchdarkly/cpp-sdks:launchdarkly-cpp-server-v@3
# LaunchDarkly Lua SDK consumed by the lua-server validator.
LUA_SDK_VERSION=luarocks:launchdarkly/launchdarkly-server-sdk@2
# LaunchDarkly Erlang SDK consumed by the erlang-server validator.
LD_ERLANG_VERSION=hex:launchdarkly_server_sdk@3
# LaunchDarkly Flutter v2 SDK consumed by the flutter-client-v2 validator.
LD_FLUTTER_V2_SDK_VERSION=pub:launchdarkly_flutter_client_sdk@2
# LaunchDarkly Flutter v3 SDK consumed by the flutter-client-v3 validator.
LD_FLUTTER_V3_SDK_VERSION=pub:launchdarkly_flutter_client_sdk@3
# LaunchDarkly Flutter current SDK consumed by the flutter-client validator.
LD_FLUTTER_SDK_VERSION=pub:launchdarkly_flutter_client_sdk@4
# LaunchDarkly Haskell SDK (4.x) consumed by the haskell-server validator.
LD_HASKELL_VERSION=hackage:launchdarkly-server-sdk@4
# LaunchDarkly Haskell v3 SDK consumed by the haskell-server-v3 validator.
LD_HASKELL_V3_VERSION=hackage:launchdarkly-server-sdk@3
